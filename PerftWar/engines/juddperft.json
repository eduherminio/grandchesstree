{
  "name": "juddperft",
  "version": "main",
  "owner": "jniemann66",
  "repo": "https://github.com/jniemann66/juddperft",
  "_note": "Juddperft only exposes a hashtable-accelerated perftfast — no 'no-cache' mode. Wrapper re-spawns per call, so the TT is cold each time; treat these numbers as a lower bound on warm-TT throughput.",
  "modes": {
    "single-with-cache": {
      "launch": "wrappers/juddperft/run.sh --cores=1",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    },
    "multi-with-cache": {
      "launch": "wrappers/juddperft/run.sh --cores=$(nproc 2>/dev/null || sysctl -n hw.ncpu)",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    }
  }
}
