{
  "name": "pawnocchio",
  "version": "1.9",
  "owner": "JonathanHallstrom",
  "repo": "https://github.com/JonathanHallstrom/pawnocchio",
  "language": "Zig",
  "_note": "Pawnocchio is a UCI engine in Zig. Perft is the bare `perft N` form (not `go perft N`). Output summary is `Nodes searched: <nodes> in <ms>ms (<nps> nps)`. Only single-no-cache is defined.",
  "modes": {
    "single-no-cache": {
      "launch": "bin/pawnocchio/zig-out/bin/pawnocchio",
      "setup": [
        "setoption name Threads value 1",
        "setoption name Hash value 1"
      ],
      "case":   "position fen {fen}\nperft {depth}",
      "end_re": "^Nodes searched: \\d+ in \\d+ms \\(\\d+ nps\\)$",
      "quit":   "quit"
    }
  }
}
