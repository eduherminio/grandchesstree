{
  "name": "ethereal",
  "version": "14.25",
  "owner": "AndyGrant",
  "repo": "https://github.com/AndyGrant/Ethereal",
  "modes": {
    "single-no-cache": {
      "launch": "bin/ethereal/src/Ethereal",
      "setup": [
        "setoption name Threads value 1",
        "setoption name Hash value 1"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    },
    "single-with-cache": {
      "launch": "bin/ethereal/src/Ethereal",
      "setup": [
        "setoption name Threads value 1",
        "setoption name Hash value 4096"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    },
    "multi-no-cache": {
      "launch": "bin/ethereal/src/Ethereal",
      "setup": [
        "setoption name Threads value {threads}",
        "setoption name Hash value 1"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    },
    "multi-with-cache": {
      "launch": "bin/ethereal/src/Ethereal",
      "setup": [
        "setoption name Threads value {threads}",
        "setoption name Hash value 4096"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    }
  }
}
