{
  "name": "mperft",
  "version": "main",
  "owner": "abulmo",
  "repo": "https://github.com/abulmo/MPerft",
  "modes": {
    "single-no-cache": {
      "launch": "wrappers/mperft/run.sh --threads 1 --hash 0 --bulk",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    },
    "single-with-cache": {
      "launch": "wrappers/mperft/run.sh --threads 1 --hash 4096 --bulk",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    },
    "multi-no-cache": {
      "launch": "wrappers/mperft/run.sh --threads $(nproc 2>/dev/null || sysctl -n hw.ncpu) --hash 0 --bulk",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    },
    "multi-with-cache": {
      "launch": "wrappers/mperft/run.sh --threads $(nproc 2>/dev/null || sysctl -n hw.ncpu) --hash 4096 --bulk",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    }
  }
}
