{
  "name": "rubichess",
  "version": "2025.04",
  "owner": "Matthies",
  "repo": "https://github.com/Matthies/RubiChess",
  "modes": {
    "single-no-cache": {
      "launch": "bin/rubichess/src/RubiChess",
      "setup": [
        "setoption name Threads value 1",
        "setoption name Hash value 1"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    },
    "single-with-cache": {
      "launch": "bin/rubichess/src/RubiChess",
      "setup": [
        "setoption name Threads value 1",
        "setoption name Hash value 4096"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    },
    "multi-no-cache": {
      "launch": "bin/rubichess/src/RubiChess",
      "setup": [
        "setoption name Threads value {threads}",
        "setoption name Hash value 1"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    },
    "multi-with-cache": {
      "launch": "bin/rubichess/src/RubiChess",
      "setup": [
        "setoption name Threads value {threads}",
        "setoption name Hash value 4096"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    }
  }
}
