{
  "name": "halogen",
  "version": "13",
  "owner": "KierenP",
  "repo": "https://github.com/KierenP/Halogen",
  "modes": {
    "single-no-cache": {
      "launch": "bin/halogen/build/Halogen",
      "setup": [
        "setoption name Threads value 1",
        "setoption name Hash value 1"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    },
    "single-with-cache": {
      "launch": "bin/halogen/build/Halogen",
      "setup": [
        "setoption name Threads value 1",
        "setoption name Hash value 4096"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    },
    "multi-no-cache": {
      "launch": "bin/halogen/build/Halogen",
      "setup": [
        "setoption name Threads value {threads}",
        "setoption name Hash value 1"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    },
    "multi-with-cache": {
      "launch": "bin/halogen/build/Halogen",
      "setup": [
        "setoption name Threads value {threads}",
        "setoption name Hash value 4096"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit":   "quit"
    }
  }
}
